<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppShellTitleText">
        <item name="android:textColor">@color/app_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="AppSectionHeaderText">
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="AppBodyText">
        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="AppPrimaryActionButton">
        <item name="android:background">@drawable/bg_app_button_primary</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="AppSecondaryActionButton">
        <item name="android:background">@drawable/bg_app_button_secondary</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="AppPadButton" parent="AppSecondaryActionButton">
        <item name="android:background">@drawable/bg_app_pad</item>
        <item name="android:textColor">@color/app_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="AppTopNavButton">
        <item name="android:background">@drawable/bg_app_nav_button</item>
        <item name="android:textColor">@color/text_app_nav</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">14sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="AppHubTileButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">bottom|start</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">18sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
    </style>

    <style name="AppHubTilePrimaryButton" parent="AppHubTileButton">
        <item name="android:background">@drawable/bg_app_hub_tile_primary</item>
        <item name="android:textColor">@color/app_primary</item>
    </style>

    <style name="AppHubTileSecondaryButton" parent="AppHubTileButton">
        <item name="android:background">@drawable/bg_app_hub_tile_secondary</item>
        <item name="android:textColor">@color/app_secondary</item>
    </style>

    <style name="AppHubTileNeutralButton" parent="AppHubTileButton">
        <item name="android:background">@drawable/bg_app_hub_tile_neutral</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="Screen3TitleText">
        <item name="android:textColor">@color/app_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:gravity">start</item>
    </style>

    <style name="Screen3StatusText">
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Screen3SectionHeaderText">
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Screen3BodyText">
        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Screen3PrimaryActionButton">
        <item name="android:background">@drawable/bg_app_button_primary</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Screen3SecondaryActionButton">
        <item name="android:background">@drawable/bg_app_button_secondary</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Screen3MiniActionButton" parent="Screen3SecondaryActionButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="Screen3ControlTileButton" parent="Screen3SecondaryActionButton">
        <item name="android:background">@drawable/bg_screen3_clip_card</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Screen3PadButton" parent="Screen3SecondaryActionButton">
        <item name="android:background">@drawable/bg_screen3_favorite_tile_empty</item>
        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:gravity">center</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">12sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>
</resources>
