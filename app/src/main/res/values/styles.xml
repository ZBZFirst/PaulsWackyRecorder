<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Screen3TitleText">
        <item name="android:textColor">@color/sb_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Screen3StatusText">
        <item name="android:textColor">@color/sb_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Screen3SectionHeaderText">
        <item name="android:textColor">@color/sb_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Screen3BodyText">
        <item name="android:textColor">@color/sb_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Screen3PrimaryActionButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Screen3SecondaryActionButton">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/sb_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Screen3PadButton" parent="Screen3SecondaryActionButton">
        <item name="android:background">@drawable/bg_button_pad</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
