<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appBottomNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_screen4_bottom_nav"
    android:elevation="12dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/appNavCapture"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/appNavCaptureCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_nav_capture_code"
            android:textColor="@color/app_nav_inactive"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appNavCaptureLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/screen4_music_bottom_capture"
            android:textAllCaps="true"
            android:textColor="@color/app_nav_inactive"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/appNavRecorder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/appNavRecorderCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_nav_recorder_code"
            android:textColor="@color/app_nav_inactive"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appNavRecorderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/screen4_music_bottom_recorder"
            android:textAllCaps="true"
            android:textColor="@color/app_nav_inactive"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/appNavBoard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/appNavBoardCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_nav_board_code"
            android:textColor="@color/app_nav_inactive"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appNavBoardLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/screen4_music_bottom_board"
            android:textAllCaps="true"
            android:textColor="@color/app_nav_inactive"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/appNavController"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/appNavControllerCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_nav_controller_code"
            android:textColor="@color/app_nav_inactive"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appNavControllerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/screen4_music_bottom_controller"
            android:textAllCaps="true"
            android:textColor="@color/app_nav_inactive"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/appNavHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/appNavHomeCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_nav_home_code"
            android:textColor="@color/app_nav_inactive"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appNavHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/screen4_music_bottom_home"
            android:textAllCaps="true"
            android:textColor="@color/app_nav_inactive"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
