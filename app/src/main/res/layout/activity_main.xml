<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_canvas"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_app_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mainBrandEyebrow"
                    android:textAllCaps="true"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/titleText"
                    style="@style/AppShellTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/mainScreenText"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/mainIntroSubtitle"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mainIntroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/mainIntroTitleText"
                    style="@style/AppSectionHeaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mainHubIntroTitleWelcome" />

                <TextView
                    android:id="@+id/mainIntroBodyText"
                    style="@style/AppBodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/mainHubIntroBodyWelcome" />

                <Button
                    android:id="@+id/mainIntroPrimaryButton"
                    style="@style/AppPrimaryActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/mainHubIntroStartSetup" />

                <Button
                    android:id="@+id/mainIntroSecondaryButton"
                    style="@style/AppSecondaryActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/mainHubIntroNotNow" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/AppSectionHeaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mainStatusTitle" />

                <TextView
                    android:id="@+id/deviceStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_app_section_high"
                    android:padding="12dp"
                    android:text="@string/device_status_placeholder"
                    android:textAppearance="@android:style/TextAppearance.Material.Small"
                    android:textColor="@color/app_text_secondary"
                    tools:text="SDK 34&#10;Camera: HW=Yes, Permission=No" />

                <Button
                    android:id="@+id/requestPermissionsButton"
                    style="@style/AppSecondaryActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/request_permissions_button" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tutorialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/AppSectionHeaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mainTutorialTitle" />

                <TextView
                    android:id="@+id/tutorialSummaryText"
                    style="@style/AppBodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/mainTutorialSummaryDefault" />

                <Button
                    android:id="@+id/startTutorialButton"
                    style="@style/AppPrimaryActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/mainTutorialStart" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/redoTutorialButton"
                        style="@style/AppSecondaryActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mainTutorialRedo" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/skipTutorialButton"
                        style="@style/AppSecondaryActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mainTutorialSkip" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/frameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/AppSectionHeaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mainRoutesTitle" />

                <LinearLayout
                    android:id="@+id/mainMenuGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/screen1Button"
                            style="@style/AppHubTilePrimaryButton"
                            android:layout_width="0dp"
                            android:layout_height="136dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:maxLines="3"
                            android:text="@string/button1text" />

                        <Button
                            android:id="@+id/screen2Button"
                            style="@style/AppHubTileSecondaryButton"
                            android:layout_width="0dp"
                            android:layout_height="136dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:maxLines="3"
                            android:text="@string/button2text" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/screen3Button"
                            style="@style/AppHubTileNeutralButton"
                            android:layout_width="0dp"
                            android:layout_height="136dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:maxLines="3"
                            android:text="@string/button3text" />

                        <Button
                            android:id="@+id/screen4Button"
                            style="@style/AppHubTileSecondaryButton"
                            android:layout_width="0dp"
                            android:layout_height="136dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:maxLines="3"
                            android:text="@string/button4text" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/AppSectionHeaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mainSupportTitle" />

                <TextView
                    style="@style/AppBodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/mainSupportSummary" />

                <Button
                    android:id="@+id/supportProjectButton"
                    style="@style/AppSecondaryActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/mainSupportButton" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
