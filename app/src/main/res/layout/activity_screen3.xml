<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/screenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/screen3TitleText"
        android:textSize="28sp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <include
            android:id="@+id/topNavInclude"
            layout="@layout/view_top_navigation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/soundboardScrollRoot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topNavInclude">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/soundboardStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/soundboard_state_loading"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/soundboardLoadingDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/soundboard_state_loading_progress_initial" />

                <ProgressBar
                    android:id="@+id/soundboardLoadingProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:indeterminate="false"
                    android:max="1" />

                <Button
                    android:id="@+id/soundboardSelectFolderButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/soundboard_select_folder" />

                <Button
                    android:id="@+id/soundboardSettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/soundboard_settings_button" />

                <LinearLayout
                    android:id="@+id/soundboardFolderNavRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/soundboardFolderPrevButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/soundboard_folder_prev" />

                    <TextView
                        android:id="@+id/soundboardFolderNameText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:text="@string/soundboard_folder_none"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/soundboardFolderNextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/soundboard_folder_next" />
                </LinearLayout>

                <!-- Phase 3: Favorites frame with collapse/expand -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@android:color/darker_gray"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/soundboardPadTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/soundboard_favorites_title"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/soundboardToggleFavoritesSectionButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/soundboard_section_collapse" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/soundboardFavoritesSectionBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/soundboardFavoritesHintText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/soundboard_favorites_hint"
                            android:textSize="12sp" />

                        <GridLayout
                            android:id="@+id/soundboardFavoritesPad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alignmentMode="alignMargins"
                            android:columnCount="3"
                            android:rowCount="3"
                            android:useDefaultMargins="true">

                            <Button android:id="@+id/favoritePadButton1" android:layout_width="0dp" android:layout_height="84dp" android:layout_columnWeight="1" android:text="@string/soundboard_favorite_slot_empty" />
                            <Button android:id="@+id/favoritePadButton2" android:layout_width="0dp" android:layout_height="84dp" android:layout_columnWeight="1" android:text="@string/soundboard_favorite_slot_empty" />
                            <Button android:id="@+id/favoritePadButton3" android:layout_width="0dp" android:layout_height="84dp" android:layout_columnWeight="1" android:text="@string/soundboard_favorite_slot_empty" />
                            <Button android:id="@+id/favoritePadButton4" android:layout_width="0dp" android:layout_height="84dp" android:layout_columnWeight="1" android:text="@string/soundboard_favorite_slot_empty" />
                            <Button android:id="@+id/favoritePadButton5" android:layout_width="0dp" android:layout_height="84dp" android:layout_columnWeight="1" android:text="@string/soundboard_favorite_slot_empty" />
                            <Button android:id="@+id/favoritePadButton6" android:layout_width="0dp" android:layout_height="84dp" android:layout_columnWeight="1" android:text="@string/soundboard_favorite_slot_empty" />
                            <Button android:id="@+id/favoritePadButton7" android:layout_width="0dp" android:layout_height="84dp" android:layout_columnWeight="1" android:text="@string/soundboard_favorite_slot_empty" />
                            <Button android:id="@+id/favoritePadButton8" android:layout_width="0dp" android:layout_height="84dp" android:layout_columnWeight="1" android:text="@string/soundboard_favorite_slot_empty" />
                            <Button android:id="@+id/favoritePadButton9" android:layout_width="0dp" android:layout_height="84dp" android:layout_columnWeight="1" android:text="@string/soundboard_favorite_slot_empty" />
                        </GridLayout>

                        <LinearLayout
                            android:id="@+id/soundboardAssignmentRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/soundboardAssignmentTargetText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/soundboard_assignment_target_default" />

                            <Button
                                android:id="@+id/soundboardClearSelectedSlotButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/soundboard_assignment_clear_slot" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Phase 3: Clip browser frame with collapse/expand and vertical list -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@android:color/darker_gray"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/soundboardBrowserTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/soundboard_browser_title"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/soundboardToggleBrowserSectionButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/soundboard_section_collapse" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/soundboardBrowserSectionBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                    <TextView
                        android:id="@+id/soundboardBrowserCountText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/soundboard_browser_count"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/soundboardBrowserHintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/soundboard_browser_hint"
                        android:textSize="12sp" />

                        <ScrollView
                            android:id="@+id/soundboardClipBrowserScroll"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:fillViewport="true">

                            <LinearLayout
                                android:id="@+id/soundboardClipBrowserContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="4dp" />
                        </ScrollView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
