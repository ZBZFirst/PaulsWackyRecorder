<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen3Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_canvas">

    <include
        layout="@layout/view_app_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        layout="@layout/view_app_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/screen3ScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/appBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/screen3TutorialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_app_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/screen3TutorialProgressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/screen3TutorialPromptText"
                    style="@style/AppSectionHeaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/screen3TutorialInstructionText"
                    style="@style/AppBodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/screen3TutorialSkipButton"
                    style="@style/AppSecondaryActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/screen3_tutorial_skip" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/screen3TutorialHandoffCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_app_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/screen3TutorialHandoffTitle"
                    style="@style/AppSectionHeaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/screen3_tutorial_handoff_title" />

                <TextView
                    android:id="@+id/screen3TutorialHandoffSummary"
                    style="@style/AppBodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/screen3_tutorial_handoff_summary" />

                <Button
                    android:id="@+id/screen3ContinueTutorialButton"
                    style="@style/AppPrimaryActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/screen3_tutorial_continue_to_sequencer" />

                <Button
                    android:id="@+id/screen3CloseTutorialButton"
                    style="@style/AppSecondaryActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/screen3_tutorial_close_and_keep_exploring" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/soundboardFavoritesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/soundboardFavoritesHeaderRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_app_section"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_screen3_page_dot_secondary" />

                    <TextView
                        android:id="@+id/soundboardPadTitle"
                        style="@style/Screen3SectionHeaderText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/soundboard_favorites_title" />

                    <Button
                        android:id="@+id/soundboardFavoritesToggleButton"
                        style="@style/Screen3MiniActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:text="@string/soundboard_favorite_pad_delete_mode_off_button" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <GridLayout
                        android:id="@+id/soundboardFavoritesPad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alignmentMode="alignMargins"
                        android:columnCount="3"
                        android:rowCount="3"
                        android:useDefaultMargins="true">

                        <Button
                            android:id="@+id/favoritePadButton1"
                            style="@style/Screen3PadButton"
                            android:layout_width="0dp"
                            android:layout_height="92dp"
                            android:layout_columnWeight="1"
                            android:text="@string/soundboard_favorite_slot_empty" />

                        <Button
                            android:id="@+id/favoritePadButton2"
                            style="@style/Screen3PadButton"
                            android:layout_width="0dp"
                            android:layout_height="92dp"
                            android:layout_columnWeight="1"
                            android:text="@string/soundboard_favorite_slot_empty" />

                        <Button
                            android:id="@+id/favoritePadButton3"
                            style="@style/Screen3PadButton"
                            android:layout_width="0dp"
                            android:layout_height="92dp"
                            android:layout_columnWeight="1"
                            android:text="@string/soundboard_favorite_slot_empty" />

                        <Button
                            android:id="@+id/favoritePadButton4"
                            style="@style/Screen3PadButton"
                            android:layout_width="0dp"
                            android:layout_height="92dp"
                            android:layout_columnWeight="1"
                            android:text="@string/soundboard_favorite_slot_empty" />

                        <Button
                            android:id="@+id/favoritePadButton5"
                            style="@style/Screen3PadButton"
                            android:layout_width="0dp"
                            android:layout_height="92dp"
                            android:layout_columnWeight="1"
                            android:text="@string/soundboard_favorite_slot_empty" />

                        <Button
                            android:id="@+id/favoritePadButton6"
                            style="@style/Screen3PadButton"
                            android:layout_width="0dp"
                            android:layout_height="92dp"
                            android:layout_columnWeight="1"
                            android:text="@string/soundboard_favorite_slot_empty" />

                        <Button
                            android:id="@+id/favoritePadButton7"
                            style="@style/Screen3PadButton"
                            android:layout_width="0dp"
                            android:layout_height="92dp"
                            android:layout_columnWeight="1"
                            android:text="@string/soundboard_favorite_slot_empty" />

                        <Button
                            android:id="@+id/favoritePadButton8"
                            style="@style/Screen3PadButton"
                            android:layout_width="0dp"
                            android:layout_height="92dp"
                            android:layout_columnWeight="1"
                            android:text="@string/soundboard_favorite_slot_empty" />

                        <Button
                            android:id="@+id/favoritePadButton9"
                            style="@style/Screen3PadButton"
                            android:layout_width="0dp"
                            android:layout_height="92dp"
                            android:layout_columnWeight="1"
                            android:text="@string/soundboard_favorite_slot_empty" />
                    </GridLayout>

                    <LinearLayout
                        android:id="@+id/soundboardFavoritePageRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/soundboardFavoritePagePrevButton"
                            style="@style/Screen3MiniActionButton"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:text="@string/soundboard_favorite_page_prev" />

                        <LinearLayout
                            android:id="@+id/soundboardFavoritePageDotsContainer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/soundboardFavoritePageStatusText"
                            style="@style/Screen3BodyText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/soundboardFavoritePageNextButton"
                            style="@style/Screen3MiniActionButton"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:text="@string/soundboard_favorite_page_next" />

                        <Button
                            android:id="@+id/soundboardFavoritePageAddButton"
                            style="@style/Screen3MiniActionButton"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="@string/soundboard_favorite_page_add" />

                        <Button
                            android:id="@+id/soundboardFavoritePageRemoveButton"
                            style="@style/Screen3MiniActionButton"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="@string/soundboard_favorite_page_remove" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/soundboardFavoritePagePresetRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/soundboardFavoritePageSaveButton"
                            style="@style/Screen3SecondaryActionButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="@string/soundboard_favorite_page_save" />

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="wrap_content" />

                        <Button
                            android:id="@+id/soundboardFavoritePageLoadButton"
                            style="@style/Screen3SecondaryActionButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="@string/soundboard_favorite_page_load" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/soundboardAssignmentRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_app_section"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/soundboardAssignmentTargetText"
                            style="@style/Screen3BodyText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/soundboard_assignment_target_default" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/soundboardBrowserCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/soundboardBrowserHeaderRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_app_section"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_screen3_page_dot_active" />

                    <TextView
                        android:id="@+id/soundboardBrowserTitle"
                        style="@style/Screen3SectionHeaderText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/soundboard_browser_title" />

                    <LinearLayout
                        android:id="@+id/soundboardFolderNavRow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_app_section_high"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <Button
                            android:id="@+id/soundboardFolderPrevButton"
                            style="@style/Screen3MiniActionButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="@string/soundboard_folder_prev" />

                        <Spinner
                            android:id="@+id/soundboardFolderSpinner"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_app_section"
                            android:gravity="center_vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:popupBackground="@drawable/bg_app_section_high"
                            android:spinnerMode="dropdown" />

                        <Button
                            android:id="@+id/soundboardFolderNextButton"
                            style="@style/Screen3MiniActionButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="@string/soundboard_folder_next" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/soundboardBrowserToggleButton"
                        style="@style/Screen3MiniActionButton"
                        android:layout_width="40dp"
                        android:layout_height="32dp"
                        android:text="@string/soundboard_section_collapse" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/soundboardClipBrowserScroll"
                    android:layout_width="match_parent"
                    android:layout_height="188dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_screen3_nested_scroll_region"
                    android:clipToOutline="true"
                    android:fillViewport="true"
                    android:padding="12dp"
                    android:scrollbarStyle="insideInset"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/soundboardClipBrowserContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/soundboardControlsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/soundboardControlsHeaderRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_app_section"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_screen3_page_dot_neutral" />

                    <TextView
                        android:id="@+id/soundboardControlsTitle"
                        style="@style/Screen3SectionHeaderText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/soundboard_controls_title" />

                    <Button
                        android:id="@+id/soundboardControlsToggleButton"
                        style="@style/Screen3MiniActionButton"
                        android:layout_width="40dp"
                        android:layout_height="32dp"
                        android:text="@string/soundboard_section_collapse" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/soundboardControlsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignMargins"
                    android:columnCount="2"
                    android:padding="12dp"
                    android:rowCount="2"
                    android:useDefaultMargins="true">

                    <Button
                        android:id="@+id/soundboardSelectFolderButton"
                        style="@style/Screen3ControlTileButton"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_columnWeight="1"
                        android:text="@string/soundboard_select_folder" />

                    <Button
                        android:id="@+id/soundboardSettingsButton"
                        style="@style/Screen3ControlTileButton"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_columnWeight="1"
                        android:text="@string/soundboard_settings_button" />

                    <Button
                        android:id="@+id/soundboardRescanLibraryButton"
                        style="@style/Screen3ControlTileButton"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_columnWeight="1"
                        android:text="@string/soundboard_rescan_library" />

                    <Button
                        android:id="@+id/soundboardClearSelectedSlotButton"
                        style="@style/Screen3ControlTileButton"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_columnWeight="1"
                        android:text="@string/soundboard_assignment_clear_slot" />
                </GridLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/soundboardStatusText"
                style="@style/Screen3BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/soundboard_state_loading"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/soundboardLoadingProgressRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/soundboardLoadingDetailText"
                    style="@style/Screen3BodyText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/soundboard_loading_detail_idle" />

                <ProgressBar
                    android:id="@+id/soundboardLoadingProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:indeterminate="true"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/app_secondary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.example.templei.feature.tutorial.TutorialSpotlightOverlayView
        android:id="@+id/screen3TutorialOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/appBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appTopBar" />
</androidx.constraintlayout.widget.ConstraintLayout>
